{
  "venvPath": ".",
  "venv": ".venv",
  "extraPaths": [
    "."
  ],
  "typeCheckingMode": "basic",
  "reportPrivateImportUsage": "none",
  "reportAttributeAccessIssue": "warning",
  "include": [
    "policy",
    "scripts"
  ],
  "exclude": [
    ".venv",
    "**/node_modules",
    "**/__pycache__",
    "tests",
  ],
}
